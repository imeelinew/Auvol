<Window
    x:Class="Auvol.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Auvol">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar"
                  Title="Auvol">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Auvol.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="960"
                  Padding="40,28,40,40"
                  HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,28">
                    <TextBlock Text="Auvol"
                               Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="局域网系统音频传输"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="连接"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           Margin="0,0,0,12" />

                <Border Grid.Row="2"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Padding="16" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE968;"
                                      FontSize="20"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="对端 Mac"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="局域网 IPv4"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox x:Name="PeerIpTextBox"
                                     Grid.Column="2"
                                     VerticalAlignment="Center"
                                     PlaceholderText="192.168.101.162"
                                     AutomationProperties.AutomationId="PeerIpAddress"
                                     TextChanged="PeerIpTextBox_TextChanged" />
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <Grid Grid.Row="2" Padding="16" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE702;"
                                      FontSize="20"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="自动跟随耳机"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="FollowedOutputText"
                                           Text="未选择"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="12">
                                <Button x:Name="UseCurrentOutputButton"
                                        Content="设为当前"
                                        Click="UseCurrentOutputButton_Click"
                                        AutomationProperties.AutomationId="UseCurrentOutput" />
                                <ToggleSwitch x:Name="AutoFollowToggle"
                                              OffContent="关"
                                              OnContent="开"
                                              Toggled="AutoFollowToggle_Toggled"
                                              AutomationProperties.AutomationId="AutoFollowHeadphones" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <Grid Grid.Row="4" Padding="16" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE774;"
                                      FontSize="20"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="连接状态"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ConnectionPathText"
                                           Text="—"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border x:Name="StatePill"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    CornerRadius="4"
                                    Padding="10,4"
                                    Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="8">
                                    <Ellipse x:Name="StateDot"
                                             Width="6"
                                             Height="6"
                                             VerticalAlignment="Center"
                                             Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="ConnectionStateText"
                                               Text="空闲"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="3"
                           Text="音频传输"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           Margin="0,0,0,12" />

                <Border Grid.Row="4"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Padding="16" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8AB;"
                                      FontSize="20"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="传输方向"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <SelectorBar x:Name="DirectionSelector"
                                         Grid.Column="2"
                                         SelectionChanged="DirectionSelector_SelectionChanged">
                                <SelectorBarItem x:Name="SendModeItem"
                                                 Text="Windows → Mac"
                                                 IsSelected="True"
                                                 AutomationProperties.AutomationId="SendToMac">
                                    <SelectorBarItem.Icon>
                                        <FontIcon Glyph="&#xE72A;" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                                <SelectorBarItem x:Name="ReceiveModeItem"
                                                 Text="Mac → Windows"
                                                 AutomationProperties.AutomationId="ReceiveFromMac">
                                    <SelectorBarItem.Icon>
                                        <FontIcon Glyph="&#xE896;" />
                                    </SelectorBarItem.Icon>
                                </SelectorBarItem>
                            </SelectorBar>
                        </Grid>

                        <Border Grid.Row="1"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <Grid Grid.Row="2" Padding="16" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE768;"
                                      FontSize="20"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="传输控制"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            </StackPanel>
                            <Button x:Name="TransportButton"
                                    Grid.Column="2"
                                    MinWidth="136"
                                    HorizontalContentAlignment="Center"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Content="开始传输"
                                    Click="TransportButton_Click"
                                    AutomationProperties.AutomationId="TransportToggle" />
                        </Grid>
                    </Grid>
                </Border>

                <InfoBar x:Name="TransportInfoBar"
                         Grid.Row="5"
                         Margin="0,12,0,28"
                         IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Title="已暂停"
                         Message="选择方向后开始传输" />

                <TextBlock Grid.Row="6"
                           Text="鼠标接管"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           Margin="0,0,0,12" />

                <Border Grid.Row="7"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Padding="16" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE962;"
                                      FontSize="20"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="鼠标接管"
                                       VerticalAlignment="Center"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ToggleSwitch x:Name="MouseShareToggle"
                                          Grid.Column="2"
                                          OffContent="关"
                                          OnContent="开"
                                          Toggled="MouseShareToggle_Toggled"
                                          AutomationProperties.AutomationId="MouseShare" />
                        </Grid>

                        <Grid x:Name="MouseCursorRow"
                              Grid.Row="1"
                              Padding="16"
                              ColumnSpacing="16"
                              Visibility="Collapsed"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B0;"
                                      FontSize="20"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="光标位置"
                                       VerticalAlignment="Center"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <SelectorBar x:Name="CursorHostSelector"
                                         Grid.Column="2"
                                         SelectionChanged="CursorHostSelector_SelectionChanged">
                                <SelectorBarItem x:Name="CursorMacItem"
                                                 Text="Mac"
                                                 AutomationProperties.AutomationId="CursorMac" />
                                <SelectorBarItem x:Name="CursorWindowsItem"
                                                 Text="Windows"
                                                 IsSelected="True"
                                                 AutomationProperties.AutomationId="CursorWindows" />
                            </SelectorBar>
                        </Grid>

                        <Grid x:Name="MouseHotkeyRow"
                              Grid.Row="2"
                              Padding="16"
                              ColumnSpacing="16"
                              Visibility="Collapsed"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE92E;"
                                      FontSize="20"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="切换快捷键"
                                       VerticalAlignment="Center"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <Border Padding="8,4"
                                        CornerRadius="4"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <TextBlock x:Name="MouseHotkeyText"
                                               Text="Ctrl + Alt + M"
                                               FontFamily="Cascadia Mono"
                                               Style="{ThemeResource CaptionTextBlockStyle}" />
                                </Border>
                                <Button x:Name="MouseHotkeyButton"
                                        Content="更改"
                                        Click="MouseHotkeyButton_Click"
                                        AutomationProperties.AutomationId="MouseHotkeyChange" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="8"
                           Text="状态"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           Margin="0,0,0,12" />

                <Border Grid.Row="9"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DeviceLabel"
                                       Text="采集设备"
                                       Style="{ThemeResource BodyTextBlockStyle}" />
                            <TextBlock x:Name="DeviceValue"
                                       Grid.Column="1"
                                       Text="—"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap" />
                        </Grid>
                        <Border Height="1"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="信号"
                                       Style="{ThemeResource BodyTextBlockStyle}" />
                            <Grid Grid.Column="1"
                                  Width="150"
                                  VerticalAlignment="Center">
                                <Rectangle Height="4"
                                           RadiusX="2"
                                           RadiusY="2"
                                           Fill="{ThemeResource CardStrokeColorDefaultBrush}" />
                                <Rectangle x:Name="SignalMeterFill"
                                           Width="0"
                                           Height="4"
                                           RadiusX="2"
                                           RadiusY="2"
                                           HorizontalAlignment="Left"
                                           Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            </Grid>
                            <TextBlock x:Name="SignalValue"
                                       Grid.Column="2"
                                       Text="—"
                                       MinWidth="76"
                                       TextAlignment="Right"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        </Grid>
                        <Border Height="1"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                        <Grid Padding="16,12" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="链路"
                                       Style="{ThemeResource BodyTextBlockStyle}" />
                            <TextBlock x:Name="QualityValue"
                                       Grid.Column="1"
                                       Text="—"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="TransportStats" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
